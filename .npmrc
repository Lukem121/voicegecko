# node-linker=hoisted
# link-workspace-packages=true

# Use PNPM's native symlink strategy instead of hoisting
# node-linker=hoisted  # Commented out - this was causing phantom dependency issues
link-workspace-packages=true

# Prevent phantom dependencies
strict-peer-dependencies=true
auto-install-peers=false

# Better resolution for monorepos
prefer-workspace-packages=true
shared-workspace-lockfile=true
