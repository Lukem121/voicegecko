{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "extends": ["ultracite"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!scripts",
      "!packages/ui",
      "!apps/desktop/src/routeTree.gen.ts"
    ]
  },
  "linter": {
    "rules": {
      "nursery": {
        "noUnnecessaryConditions": "off"
      },
      "style": {
        "noMagicNumbers": "off"
      }
    }
  }
}
