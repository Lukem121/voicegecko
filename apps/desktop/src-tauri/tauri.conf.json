{
  "productName": "Voice Gecko",
  "version": "0.1.0",
  "identifier": "com.voice-gecko.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:vite",
    "beforeBuildCommand": "pnpm build:vite"
  },
  "app": {
    "windows": [
      {
        "title": "Voice Gecko",
        "width": 1350,
        "height": 820,
        "closable": false,
        "minimizable": true,
        "maximizable": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        { "host": "voicegecko.io", "pathPrefix": ["/login"] },
        { "host": "voicegecko.io" }
      ],
      "desktop": {
        "schemes": ["voicegecko"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "$schema": "../../../node_modules/@tauri-apps/cli/schema.json"
}
