{
  "extends": "@acme/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@acme/ui/*": ["../../packages/ui/src/*"]
    },

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "target": "ES2020"
  },
  "include": ["*.ts", "src", "src/routes/index.tsx"],
  "exclude": ["node_modules"]
}
