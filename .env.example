# Copy to `.env` in the repo root (gitignored). Never commit real secrets.
# Values below are placeholders — replace for local development.
# Maintainer-only: live Stripe keys, Tauri signing, production DB, release tokens.

# --- Core ---
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/voicegecko
AUTH_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_VOICEGECKO_URL=http://localhost:3000
VOICEGECKO_APP_URL=http://localhost:3000

# --- Auth providers ---
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# --- Stripe (Support / Pro checkout) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID_PRO_MONTHLY=price_replace_me
STRIPE_PRICE_ID_PRO_YEARLY=price_replace_me
# Optional: legacy Team plan price IDs (new Team checkout is disabled)
# STRIPE_PRICE_ID_TEAM_MONTHLY=
# STRIPE_PRICE_ID_TEAM_YEARLY=

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email / analytics / ops ---
SENDGRID_API_KEY=SG.replace_me
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
REVALIDATE_SECRET=replace-me
SENTRY_AUTH_TOKEN=

# --- Desktop updater (maintainer / release infra) ---
GITHUB_TOKEN=
GITHUB_OWNER=Lukem121
GITHUB_REPO=voicegecko-releases

# Desktop local overrides: see apps/desktop/.env.development.example
# Speech models download on first run (network required once). No OpenAI key needed.
