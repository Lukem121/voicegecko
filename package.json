{
  "name": "voicegecko",
  "private": true,
  "description": "Free and open-source instant voice-to-text dictation for desktop and web",
  "license": "MIT",
  "homepage": "https://www.voicegecko.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lukem121/voicegecko.git"
  },
  "bugs": {
    "url": "https://github.com/Lukem121/voicegecko/issues"
  },
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=9.6.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "auth:generate": "pnpm -F @acme/auth generate",
    "db:push": "turbo -F @acme/db push",
    "db:studio": "turbo -F @acme/db studio",
    "dev": "turbo watch dev --continue",
    "dev:web": "turbo watch dev -F @acme/web...",
    "lint": "ultracite lint",
    "format": "ultracite format",
    "lint:ws": "pnpm dlx sherif@latest",
    "bump-deps": "npx npm-check-updates --deep -u -x react-day-picker && pnpm install",
    "postinstall": "pnpm lint:ws",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add",
    "version:check": "node scripts/check-versions.js",
    "version:bump": "node scripts/bump-version.js",
    "pre-release": "node scripts/pre-release.js",
    "release": "node scripts/release-helper.js"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@turbo/gen": "^2.8.9",
    "glob": "^13.0.3",
    "turbo": "^2.8.9",
    "ultracite": "7.2.1"
  }
}
